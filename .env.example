# TripFlow AI — public Vite keys (never put backend-only secrets here)
# Copy to .env.local. The app runs without any of these.

# Optional. OSM + Leaflet maps work with no key.
# Use only if you switch the maps provider later (Mapbox / Google / Geoapify).
VITE_MAPS_API_KEY=
VITE_GEOAPIFY_KEY=

# Optional. Open-Meteo weather works with no key.
VITE_WEATHER_API_KEY=

# Optional. Nominatim / Overpass place search works with no key.
VITE_PLACES_API_KEY=

# Optional. Enables OpenAI ranking. Exposed to the browser — use a backend proxy in production.
VITE_AI_API_KEY=

# Optional. Open ER-API FX works with no key.
VITE_CURRENCY_API_KEY=

# Optional. Set this on Vercel when the API runs on Render.
# Example: https://tripflow.onrender.com
VITE_API_BASE=

# Backend-only. NEVER prefix with VITE_. Never expose to the browser.
# Used by the Vite travel API plugin at /api/travel/*
SERPAPI_API_KEY=

# Render only. Comma-separated Vercel origins allowed to call the API.
# Example: https://tripflow.vercel.app
FRONTEND_ORIGIN=

# Optional. Server-only Digital Twin narrative via OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Nugen Intelligence (HackCelestial mandatory). Server only.
NUGEN_API_KEY=
NUGEN_BASE_MODEL=qwen-v2p5-0p5b-instruct
NUGEN_CHAT_MODEL=glm-5p2
NUGEN_ALIGNED_MODEL=
AVIATIONSTACK_API_KEY=
RAILRADAR_API_KEY=
